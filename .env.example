# Groq API key for the AI chat (get one at https://console.groq.com/keys)
# NEVER commit the real key. Put it in .env.local (local) and in Vercel → Settings → Environment Variables (live).
GROQ_API_KEY=

# Your live website address (used for SEO canonical links + chat CORS)
NEXT_PUBLIC_SITE_URL=https://tahyascartraining.com

# Optional: extra allowed origins for the chat API, comma separated
ALLOWED_ORIGINS=

# Optional: Groq model id (default: openai/gpt-oss-120b)
GROQ_MODEL=
